<script>
const screenIds = [
    'welcome',
    'gift',
    'memories',
    'envelope',
    'letter',
    'ending'
];

let giftOpened = false;
let envelopeOpened = false;
let musicOn = false;
let audioContext = null;
let musicTimer = null;


function goTo(id) {
    screenIds.forEach(screenId => {
        document.getElementById(screenId)
            .classList.toggle('active', screenId === id);
    });

    window.scrollTo({
        top: 0,
        behavior: 'smooth'
    });
}


function openGift() {
    if (giftOpened) return;

    giftOpened = true;

    document.getElementById('giftBox')
        .classList.add('open');

    document.getElementById('giftMessage').textContent =
        'A little surprise, just for you! ♡';
}


function openEnvelope() {
    if (envelopeOpened) {
        goTo('letter');
        return;
    }

    envelopeOpened = true;

    const envelope =
        document.getElementById('envelopeArea');

    const button =
        document.getElementById('openLetterButton');

    envelope.classList.add('open');

    button.textContent = 'Opening your letter... 💌';
    button.disabled = true;

    setTimeout(() => {
        button.disabled = false;
        button.textContent = 'Read My Letter ♡';
        goTo('letter');
    }, 1100);
}


/* Tombol keyboard untuk hadiah dan amplop */

document.getElementById('giftBox')
    .addEventListener('keydown', function(event) {
        if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            openGift();
        }
    });

document.getElementById('envelopeArea')
    .addEventListener('keydown', function(event) {
        if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            openEnvelope();
        }
    });


/* MUSIK LATAR */

function toggleMusic() {
    const button =
        document.getElementById('musicButton');

    const AudioContextClass =
        window.AudioContext || window.webkitAudioContext;

    if (!AudioContextClass) {
        button.textContent = '♫ Audio unavailable';
        return;
    }

    if (!musicOn) {
        audioContext = new AudioContextClass();
        musicOn = true;

        button.textContent = '♫ Music: on';

        const notes = [
            523.25,
            659.25,
            783.99,
            659.25,
            587.33,
            698.46,
            659.25,
            523.25
        ];

        let index = 0;

        function playNote() {
            if (!musicOn || !audioContext) return;

            const oscillator =
                audioContext.createOscillator();

            const gain =
                audioContext.createGain();

            oscillator.type = 'sine';

            oscillator.frequency.value =
                notes[index % notes.length];

            gain.gain.setValueAtTime(
                0.0001,
                audioContext.currentTime
            );

            gain.gain.exponentialRampToValueAtTime(
                0.025,
                audioContext.currentTime + 0.08
            );

            gain.gain.exponentialRampToValueAtTime(
                0.0001,
                audioContext.currentTime + 0.6
            );

            oscillator.connect(gain);
            gain.connect(audioContext.destination);

            oscillator.start();

            oscillator.stop(
                audioContext.currentTime + 0.65
            );

            index++;

            musicTimer = setTimeout(playNote, 750);
        }

        playNote();

    } else {
        musicOn = false;

        clearTimeout(musicTimer);

        if (audioContext) {
            audioContext.close();
            audioContext = null;
        }

        button.textContent = '♫ Music: off';
    }
}
</script>

